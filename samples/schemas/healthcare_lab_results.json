{
  "schema": {
    "entity": "lab_result",
    "locale": "en_IN",
    "fields": {
      "result_id": {"type": "integer", "unique": true, "generator": "sequence", "min": 1},
      "sample_id": {"type": "string", "unique": true, "pattern": "LAB-\\d{4}-\\d{8}"},
      "patient_mrn": {"type": "string", "pattern": "MRN\\d{12}"},
      "test_name": {"type": "string",
                    "allowed_values": ["haemoglobin_g_dl", "fasting_glucose_mg_dl", "hba1c_pct",
                                       "total_cholesterol_mg_dl", "tsh_miu_l", "creatinine_mg_dl", "vitamin_d_ng_ml"],
                    "weights": [20, 18, 12, 14, 12, 12, 12]},
      "result_value": {"type": "float", "generator": "profile", "depends_on": "test_name", "decimals": 2,
                       "profile": {
                         "haemoglobin_g_dl": {"min": 7.5, "typical": 13.2, "max": 17.8},
                         "fasting_glucose_mg_dl": {"min": 65, "typical": 98, "max": 260},
                         "hba1c_pct": {"min": 4.2, "typical": 5.8, "max": 11.5},
                         "total_cholesterol_mg_dl": {"min": 110, "typical": 185, "max": 320},
                         "tsh_miu_l": {"min": 0.2, "typical": 2.4, "max": 12.0},
                         "creatinine_mg_dl": {"min": 0.4, "typical": 0.9, "max": 3.5},
                         "vitamin_d_ng_ml": {"min": 6, "typical": 22, "max": 80}}},
      "lab_name": {"type": "string", "allowed_values": ["Central Lab", "City Diagnostics", "Metro Pathology", "Apex Labs"]},
      "collected_on": {"type": "date", "min": "2025-01-01", "max": "2025-11-12"},
      "reported_on": {"type": "date", "depends_on": "collected_on", "offset_days": [0, 3]},
      "technician": {"type": "string", "generator": "faker", "faker_method": "name"},
      "fasting_sample": {"type": "boolean", "allowed_values": [true, false], "weights": [40, 60]}
    },
    "rules": [
      {"name": "reported_after_collection", "expression": "reported_on >= collected_on",
       "description": "A result is reported on or after the sample collection date."}
    ]
  },
  "total_records": 1000000,
  "output_format": "csv",
  "generation_instructions": "Pathology lab results; units are part of the test name."
}
