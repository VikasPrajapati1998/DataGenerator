{
  "schema": {
    "entity": "inventory_item",
    "locale": "en_IN",
    "fields": {
      "item_id": {"type": "integer", "unique": true, "generator": "sequence", "min": 1},
      "sku": {"type": "string", "unique": true, "pattern": "SKU-[A-Z]{3}\\d{8}"},
      "category": {"type": "string", "allowed_values": ["grocery", "personal_care", "home", "electronics", "apparel", "toys"],
                   "weights": [34, 16, 14, 10, 18, 8]},
      "brand": {"type": "string", "generator": "faker", "faker_method": "company"},
      "unit_cost_inr": {"type": "float", "generator": "profile", "depends_on": "category", "decimals": 2,
                        "profile": {"grocery": {"min": 8, "typical": 65, "max": 900},
                                    "personal_care": {"min": 25, "typical": 140, "max": 1500},
                                    "home": {"min": 40, "typical": 380, "max": 6000},
                                    "electronics": {"min": 250, "typical": 1800, "max": 60000},
                                    "apparel": {"min": 150, "typical": 650, "max": 5000},
                                    "toys": {"min": 90, "typical": 450, "max": 4500}}},
      "stock_qty": {"type": "integer", "min": 0, "max": 5000, "distribution": {"kind": "triangular", "mode": 180}},
      "reorder_level": {"type": "integer", "min": 10, "max": 400, "distribution": {"kind": "triangular", "mode": 60}},
      "warehouse_city": {"type": "string", "generator": "geo_city"},
      "last_restock_date": {"type": "date", "min": "2025-06-01", "max": "2025-11-15"},
      "is_perishable": {"type": "boolean", "allowed_values": [true, false], "weights": [22, 78]},
      "gst_rate_pct": {"type": "integer", "allowed_values": [0, 5, 12, 18, 28], "weights": [8, 30, 20, 36, 6]}
    }
  },
  "total_records": 10000,
  "output_format": "csv",
  "generation_instructions": "Inventory of a multi-category retail chain in India."
}
