# Copy to .env and adjust. Never commit real keys.

# Local Ollama server. Prefer 127.0.0.1 over localhost: on Windows "localhost" tries IPv6 first,
# which adds ~2 s to every failed connection.
OLLAMA_HOST=http://127.0.0.1:11434
# Requests each loaded model serves concurrently (mirror the server's setting; default 1)
OLLAMA_NUM_PARALLEL=1

# Direct Ollama Cloud access (https://ollama.com/settings/keys). Not needed for "-cloud" models
# used through a signed-in local server ("ollama signin").
OLLAMA_API_KEY=
OLLAMA_CLOUD_HOST=https://ollama.com

# NVIDIA hosted API (build.nvidia.com, Nemotron models) and OpenRouter (e.g. Reflection AI Beam)
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Engine defaults
SDE_DEFAULT_MODEL=ollama_local/qwen3:0.6b
# Default model pool (one model per task, round-robin), used when a request has no model_pool
SDE_MODEL_POOL=ollama_local/qwen3:0.6b,ollama_local/llama3.2:1b,ollama_local/gemma3:1b,ollama_local/gpt-oss:120b-cloud
# Fixed records per task. Leave unset to let the engine choose at run time
# (about 8 tasks per core, 250-5000 records; 100 when records need LLM text).
# SDE_BATCH_SIZE=1000
# Global retry cap (0-20). Upper bound for: retries per LLM call (attempts = value + 1), regeneration
# rounds of rejected/missing records per task, failed-task retry rounds and global repair rounds.
# Unset = per-setting defaults (LLM attempts per model in models.json, usually 3; regeneration 4; task retries 2; repairs 2).
SDE_MAX_RETRIES=2
# RAM pre-check: warn (default) = run with fewer queues (down to 1) when RAM is tight,
# strict = stop the job, off = skip the RAM budget entirely.
# SDE_RAM_CHECK=warn
# Requests above this many records run as sequential sub-jobs that are merged at the end (0 = never split).
SDE_MAX_RECORDS_PER_JOB=100000
# Hang protection (seconds). Watchdog: stop the job when nothing progresses for this long (0 = off).
SDE_STALL_TIMEOUT=900
# Max runtime of one task in a worker process before the process is terminated (0 = off).
SDE_TASK_TIMEOUT=7200
# Max wait for a free model request slot.
SDE_LLM_SLOT_TIMEOUT=900
# Refuse jobs whose projected run time (from the LLM speed test) exceeds this many hours (0 = no limit).
# `generate --force` runs them anyway.
SDE_MAX_ETA_HOURS=6
# How LLM text is produced: auto | per_record | pooled. auto = pooled from SDE_POOLED_MIN_RECORDS records.
SDE_LLM_MODE=auto
SDE_POOLED_MIN_RECORDS=10000
# Pooled mode: time budget (minutes) and size of the LLM answer pool that records are recombined from.
SDE_POOL_BUILD_MINUTES=20
SDE_POOL_MAX_VALUES=2000
# Keep adding answers to the pool in the background while records are generated (true/false).
SDE_POOL_GROW=true
# Leftover invalid records (share of a task, at least 10) that get extra rescue rounds instead of failing the task.
SDE_MAX_INVALID_FRACTION=0.001
# Unload local Ollama models when a job ends, so their RAM is released immediately (true/false).
SDE_UNLOAD_MODELS=true
SDE_MAX_WORKERS=6
SDE_OUTPUT_DIR=output
SDE_LOG_DIR=logs
SDE_LOG_LEVEL=INFO
SDE_MODEL_REGISTRY=app/config/models.json

# Test switches
SDE_TEST_OLLAMA_MODEL=qwen3:0.6b
SDE_RUN_CLOUD_TESTS=1

# --- HTTP API (python -m app.api) and MCP server (python -m app.mcp_server) ---
# Nothing to set here. Per job you choose only: records, format (csv/json/jsonl/excel), mode (mock/llm)
# and compress (none/zip/gzip). mode=llm uses the model settings above (SDE_MODEL_POOL ...).
